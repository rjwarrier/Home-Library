    <string name="help_share_home_library_text">Granthapura - a local home-library app for cataloging books, shelves, covers, ratings, and loans.</string>
    <string name="privacy_local_title">Local catalog</string>
    <string name="privacy_local_body">Books, shelves, loans, notes, ratings, and locally selected covers are stored on this device in the app database and app storage.</string>
    <string name="privacy_lookup_title">ISBN lookup</string>
    <string name="privacy_lookup_body">ISBN lookup can contact external metadata sources using the ISBN you enter or scan. Lookup results are saved only when you save or update the book.</string>
    <string name="privacy_backup_title">Manual backups</string>
    <string name="privacy_backup_body">Complete backup creates a JSON file at a location you choose. That file can include catalog data and encoded local cover images, so treat it as private library data.</string>
