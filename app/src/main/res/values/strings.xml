    <string name="help_screen_title">Help and about</string>
    <string name="help_welcome_title">Welcome to Granthapura</string>
    <string name="help_welcome_body">Granthapura is a local home-library manager for cataloging books, shelves, cover images, reading status, ratings, and books lent to other people.</string>
    <string name="help_start_here">Start here</string>
    <string name="help_cd_collapse">Collapse</string>
    <string name="help_cd_expand">Expand</string>
    <string name="help_group_library_title">Library basics</string>
    <string name="help_group_library_desc">Add books, enrich metadata, and keep the details tidy.</string>
    <string name="help_group_organization_title">Organization</string>
    <string name="help_group_organization_desc">Shelves, filters, languages, tags, and loans.</string>
    <string name="help_group_data_title">Data and app settings</string>
    <string name="help_group_data_desc">Backups, privacy, appearance, and device behavior.</string>
    <string name="help_onboard_scan_title">Scan ISBNs</string>
    <string name="help_onboard_scan_body">Use the camera to scan an ISBN. Valid codes can trigger lookup automatically.</string>
    <string name="help_onboard_shelves_title">Map shelves</string>
    <string name="help_onboard_shelves_body">Create room, bookcase, and shelf locations so every book has a home.</string>
    <string name="help_onboard_loans_title">Track loans</string>
    <string name="help_onboard_loans_body">Record who borrowed a book and when it should return.</string>
    <string name="help_onboard_backup_title">Keep backups</string>
    <string name="help_onboard_backup_body">Export a complete backup with books, shelves, loans, ratings, notes, and local covers.</string>
    <string name="help_section_add_books_title">Adding books</string>
    <string name="help_section_add_books_preview">Scan an ISBN, look one up manually, or enter the book yourself.</string>
    <string name="help_section_add_books_content">Use Add book from Library to scan an ISBN or add a book manually. Title is the only required field; authors, language, publisher, year, pages, notes, synopsis, format, read status, rating, and shelf location can all be filled or edited later.</string>
    <string name="help_section_isbn_title">ISBN lookup</string>
    <string name="help_section_isbn_preview">Lookup tries to fill the strongest metadata available for a book.</string>
    <string name="help_section_isbn_content">When an ISBN is valid, Granthapura can look up title, subtitle, authors, publisher, year, page count, language, synopsis, and cover candidates. If a scanned ISBN already exists, empty fields can be filled from lookup without overwriting details you already edited.</string>
    <string name="help_section_covers_ratings_title">Covers and ratings</string>
    <string name="help_section_covers_ratings_preview">Replace covers, crop images, and star-rate books.</string>
    <string name="help_section_covers_ratings_content">Book details and edit screens let you change the cover image, use a lookup cover URL, choose a local image, crop the cover frame, and set a star rating. Ratings are used by sorting and make favorites easier to spot.</string>
    <string name="help_section_shelves_title">Shelves</string>
    <string name="help_section_shelves_preview">Create shelf locations and move books between them.</string>
    <string name="help_section_shelves_content">Shelves are stored as room, bookcase or unit, and shelf row. You can add shelves from the Shelves screen, assign a book while adding or editing it, move books later, and run a shelf audit to see what should be on a selected shelf.</string>
    <string name="help_section_filters_title">Finding books</string>
    <string name="help_section_filters_preview">Search and filter by language, status, location, and tags.</string>
    <string name="help_section_filters_content">Use Library search for title, author, notes, and ISBN. Filter chips can narrow by available language, reading status, location, tag or genre, and loan state. Author, genre, and tag inputs recommend existing values so spelling stays consistent.</string>
    <string name="help_section_loans_title">Loans</string>
    <string name="help_section_loans_preview">Know who has a book and when it is due back.</string>
    <string name="help_section_loans_content">The Loans screen shows active borrowers, books currently out, and overdue items. Create a new loan from the Loans screen or a book detail page. Mark a book returned to close the active loan while keeping the history.</string>
    <string name="help_section_backup_title">Backup and restore</string>
    <string name="help_section_backup_preview">Export a portable complete backup or restore from one.</string>
    <string name="help_section_backup_content">Settings can export a complete JSON backup containing books, shelf locations, loan history, notes, ratings, and locally available cover images. Restore reads that backup back into the app. Keep a copy somewhere safe outside the phone.</string>
    <string name="help_section_privacy_title">Local data and privacy</string>
    <string name="help_section_privacy_preview">Library data is local unless you explicitly look up, export, or share it.</string>
    <string name="help_section_privacy_content">Your catalog is stored in the app database on this device. ISBN lookup contacts external book metadata sources for the ISBN you search. Backups and exported files leave the app only when you choose where to save or share them.</string>
    <string name="help_section_appearance_title">Appearance</string>
    <string name="help_section_appearance_preview">Tune theme mode, colors, font, scale, and FAB side.</string>
    <string name="help_section_appearance_content">Appearance settings let you choose System, Light, Dark, or Amoled theme; Material You or custom color behavior; color intensity; background tint; app font family; font scale; and whether floating action buttons sit on the left or right.</string>
